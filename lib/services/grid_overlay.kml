<kml xmlns="http://www.opengis.net/kml/2.2">
    <Document>
        <name>Mars Overlay</name>
        <GroundOverlay>
            <name>Global Mars Overlay</name>
            <Icon>
                <href>output_line_preserved.png</href>
            </Icon>
            <LatLonBox>
                <north>90</north>
                <south>-90</south>
                <east>180</east>
                <west>-180</west>
            </LatLonBox>
        </GroundOverlay>
    </Document>
</kml>